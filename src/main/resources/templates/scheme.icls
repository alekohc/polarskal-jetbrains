<scheme name="{{ name }}" version="142" parent_scheme="{{ parentScheme }}">
  <colors>
    <option name="CARET_COLOR" value="{{ accent }}"/>
    <option name="CARET_ROW_COLOR" value="{{ surfaceHover }}"/>
    <option name="SELECTION_BACKGROUND" value="{{ border }}"/>
    <option name="GUTTER_BACKGROUND" value="{{ surfacePanel }}"/>
    <option name="LINE_NUMBERS_COLOR" value="{{ textDisabled }}"/>
    <option name="LINE_NUMBER_ON_CARET_ROW_COLOR" value="{{ accent }}"/>
    <option name="INDENT_GUIDE" value="{{ divider }}"/>
    <option name="SELECTED_INDENT_GUIDE" value="{{ border }}"/>
    <option name="RIGHT_MARGIN_COLOR" value="{{ divider }}"/>
    <option name="WHITESPACES" value="{{ divider }}"/>
    <option name="TEARLINE_COLOR" value="{{ divider }}"/>
    <option name="SELECTED_TEARLINE_COLOR" value="{{ border }}"/>
    <option name="METHOD_SEPARATORS_COLOR" value="{{ divider }}"/>
    <option name="ADDED_LINES_COLOR" value="{{ accent }}"/>
    <option name="MODIFIED_LINES_COLOR" value="{{ focus }}"/>
    <option name="DELETED_LINES_COLOR" value="{{ danger }}"/>
    <option name="WHITESPACES_MODIFIED_LINES_COLOR" value="{{ warning }}"/>
    <option name="DOCUMENTATION_COLOR" value="{{ surfaceRaised }}"/>
    <option name="NOTIFICATION_BACKGROUND" value="{{ surfaceRaised }}"/>
    <option name="CONSOLE_BACKGROUND_KEY" value="{{ surfacePanel }}"/>
    <option name="FILESTATUS_ADDED" value="{{ accent }}"/>
    <option name="FILESTATUS_MODIFIED" value="{{ focus }}"/>
    <option name="FILESTATUS_DELETED" value="{{ textMuted }}"/>
    <option name="FILESTATUS_UNKNOWN" value="{{ danger }}"/>
    <option name="FILESTATUS_IDEA_FILESTATUS_IGNORED" value="{{ textDisabled }}"/>
    <option name="FILESTATUS_IGNORED" value="{{ textDisabled }}"/>
    <option name="FILESTATUS_MERGED" value="{{ accentAlt }}"/>
    <option name="FILESTATUS_SWITCHED" value="{{ ice }}"/>
    <option name="FILESTATUS_HIJACKED" value="{{ warning }}"/>
    <option name="FILESTATUS_NOT_CHANGED_IMMEDIATE" value="{{ ice }}"/>
    <option name="FILESTATUS_NOT_CHANGED_RECURSIVE" value="{{ ice }}"/>
    <option name="FILESTATUS_IDEA_FILESTATUS_MERGED_WITH_CONFLICTS" value="{{ danger }}"/>
    <option name="FILESTATUS_IDEA_FILESTATUS_DELETED_FROM_FILE_SYSTEM" value="{{ textMuted }}"/>
  </colors>
  <attributes>
    <option name="TEXT"><value>
      <option name="FOREGROUND" value="{{ textPrimary }}"/>
      <option name="BACKGROUND" value="{{ surfacePanel }}"/>
    </value></option>
    <option name="DEFAULT_KEYWORD"><value><option name="FOREGROUND" value="{{ accentAlt }}"/></value></option>
    <option name="DEFAULT_LABEL"><value><option name="FOREGROUND" value="{{ accentAlt }}"/></value></option>
    <option name="DEFAULT_STRING"><value><option name="FOREGROUND" value="{{ warning }}"/></value></option>
    <option name="DEFAULT_VALID_STRING_ESCAPE"><value><option name="FOREGROUND" value="{{ focus }}"/></value></option>
    <option name="DEFAULT_NUMBER"><value><option name="FOREGROUND" value="{{ focus }}"/></value></option>
    <option name="DEFAULT_CONSTANT"><value><option name="FOREGROUND" value="{{ focus }}"/></value></option>
    <option name="DEFAULT_PREDEFINED_SYMBOL"><value><option name="FOREGROUND" value="{{ focus }}"/></value></option>
    <option name="DEFAULT_METADATA"><value><option name="FOREGROUND" value="{{ focus }}"/></value></option>
    <option name="DEFAULT_LINE_COMMENT"><value>
      <option name="FOREGROUND" value="{{ textMuted }}"/>
      <option name="FONT_TYPE" value="2"/>
    </value></option>
    <option name="DEFAULT_BLOCK_COMMENT"><value>
      <option name="FOREGROUND" value="{{ textMuted }}"/>
      <option name="FONT_TYPE" value="2"/>
    </value></option>
    <option name="DEFAULT_DOC_COMMENT"><value>
      <option name="FOREGROUND" value="{{ textMuted }}"/>
      <option name="FONT_TYPE" value="2"/>
    </value></option>
    <option name="DEFAULT_DOC_COMMENT_TAG"><value><option name="FOREGROUND" value="{{ textSecondary }}"/></value></option>
    <option name="DEFAULT_FUNCTION_DECLARATION"><value><option name="FOREGROUND" value="{{ accent }}"/></value></option>
    <option name="DEFAULT_FUNCTION_CALL"><value><option name="FOREGROUND" value="{{ accent }}"/></value></option>
    <option name="DEFAULT_CLASS_NAME"><value><option name="FOREGROUND" value="{{ ice }}"/></value></option>
    <option name="DEFAULT_CLASS_REFERENCE"><value><option name="FOREGROUND" value="{{ ice }}"/></value></option>
    <option name="DEFAULT_INTERFACE_NAME"><value><option name="FOREGROUND" value="{{ ice }}"/></value></option>
    <option name="DEFAULT_IDENTIFIER"><value><option name="FOREGROUND" value="{{ textPrimary }}"/></value></option>
    <option name="DEFAULT_OPERATION_SIGN"><value><option name="FOREGROUND" value="{{ textSecondary }}"/></value></option>
    <option name="DEFAULT_BRACES"><value><option name="FOREGROUND" value="{{ textSecondary }}"/></value></option>
    <option name="DEFAULT_BRACKETS"><value><option name="FOREGROUND" value="{{ textSecondary }}"/></value></option>
    <option name="DEFAULT_PARENTHS"><value><option name="FOREGROUND" value="{{ textSecondary }}"/></value></option>
    <option name="DEFAULT_COMMA"><value><option name="FOREGROUND" value="{{ textSecondary }}"/></value></option>
    <option name="DEFAULT_SEMICOLON"><value><option name="FOREGROUND" value="{{ textSecondary }}"/></value></option>
    <option name="DEFAULT_DOT"><value><option name="FOREGROUND" value="{{ textSecondary }}"/></value></option>
    <option name="DEFAULT_TAG"><value><option name="FOREGROUND" value="{{ accentAlt }}"/></value></option>
    <option name="DEFAULT_ATTRIBUTE"><value><option name="FOREGROUND" value="{{ ice }}"/></value></option>
    <option name="DEFAULT_ENTITY"><value><option name="FOREGROUND" value="{{ focus }}"/></value></option>
    <option name="ERRORS_ATTRIBUTES"><value>
      <option name="EFFECT_COLOR" value="{{ danger }}"/>
      <option name="ERROR_STRIPE_COLOR" value="{{ danger }}"/>
      <option name="EFFECT_TYPE" value="2"/>
    </value></option>
    <option name="WARNING_ATTRIBUTES"><value>
      <option name="EFFECT_COLOR" value="{{ warning }}"/>
      <option name="ERROR_STRIPE_COLOR" value="{{ warning }}"/>
      <option name="EFFECT_TYPE" value="2"/>
    </value></option>
    <option name="WRONG_REFERENCES_ATTRIBUTES"><value><option name="FOREGROUND" value="{{ danger }}"/></value></option>
    <option name="NOT_USED_ELEMENT_ATTRIBUTES"><value><option name="FOREGROUND" value="{{ textMuted }}"/></value></option>
    <option name="DEPRECATED_ATTRIBUTES"><value>
      <option name="EFFECT_COLOR" value="{{ textMuted }}"/>
      <option name="EFFECT_TYPE" value="3"/>
    </value></option>
    <option name="TYPO"><value>
      <option name="EFFECT_COLOR" value="{{ textMuted }}"/>
      <option name="EFFECT_TYPE" value="2"/>
    </value></option>
    <option name="HYPERLINK_ATTRIBUTES"><value>
      <option name="FOREGROUND" value="{{ ice }}"/>
      <option name="EFFECT_COLOR" value="{{ ice }}"/>
      <option name="EFFECT_TYPE" value="1"/>
    </value></option>
    <option name="SEARCH_RESULT_ATTRIBUTES"><value>
      <option name="BACKGROUND" value="{{ focus@35 }}"/>
      <option name="ERROR_STRIPE_COLOR" value="{{ focus }}"/>
    </value></option>
    <option name="TEXT_SEARCH_RESULT_ATTRIBUTES"><value>
      <option name="BACKGROUND" value="{{ focus@35 }}"/>
      <option name="ERROR_STRIPE_COLOR" value="{{ focus }}"/>
    </value></option>
    <option name="WRITE_SEARCH_RESULT_ATTRIBUTES"><value>
      <option name="BACKGROUND" value="{{ warning@30 }}"/>
      <option name="ERROR_STRIPE_COLOR" value="{{ warning }}"/>
    </value></option>
    <option name="IDENTIFIER_UNDER_CARET_ATTRIBUTES"><value>
      <option name="BACKGROUND" value="{{ focus@20 }}"/>
      <option name="ERROR_STRIPE_COLOR" value="{{ focus }}"/>
    </value></option>
    <option name="WRITE_IDENTIFIER_UNDER_CARET_ATTRIBUTES"><value>
      <option name="BACKGROUND" value="{{ warning@20 }}"/>
      <option name="ERROR_STRIPE_COLOR" value="{{ warning }}"/>
    </value></option>
    <option name="MATCHED_BRACE_ATTRIBUTES"><value>
      <option name="FOREGROUND" value="{{ accent }}"/>
      <option name="FONT_TYPE" value="1"/>
    </value></option>
    <option name="UNMATCHED_BRACE_ATTRIBUTES"><value>
      <option name="FOREGROUND" value="{{ danger }}"/>
      <option name="BACKGROUND" value="{{ danger@15 }}"/>
    </value></option>
    <option name="DIFF_INSERTED"><value>
      <option name="BACKGROUND" value="{{ accent@20 }}"/>
      <option name="ERROR_STRIPE_COLOR" value="{{ accent }}"/>
    </value></option>
    <option name="DIFF_MODIFIED"><value>
      <option name="BACKGROUND" value="{{ focus@20 }}"/>
      <option name="ERROR_STRIPE_COLOR" value="{{ focus }}"/>
    </value></option>
    <option name="DIFF_DELETED"><value>
      <option name="BACKGROUND" value="{{ danger@20 }}"/>
      <option name="ERROR_STRIPE_COLOR" value="{{ danger }}"/>
    </value></option>
    <option name="DIFF_CONFLICT"><value>
      <option name="BACKGROUND" value="{{ warning@20 }}"/>
      <option name="ERROR_STRIPE_COLOR" value="{{ warning }}"/>
    </value></option>
    <option name="CONSOLE_NORMAL_OUTPUT"><value><option name="FOREGROUND" value="{{ textPrimary }}"/></value></option>
    <option name="CONSOLE_ERROR_OUTPUT"><value><option name="FOREGROUND" value="{{ danger }}"/></value></option>
    <option name="CONSOLE_SYSTEM_OUTPUT"><value><option name="FOREGROUND" value="{{ textSecondary }}"/></value></option>
    <option name="CONSOLE_USER_INPUT"><value><option name="FOREGROUND" value="{{ accent }}"/></value></option>
    <option name="CONSOLE_BLACK_OUTPUT"><value><option name="FOREGROUND" value="{{ surfaceHover }}"/></value></option>
    <option name="CONSOLE_RED_OUTPUT"><value><option name="FOREGROUND" value="{{ danger }}"/></value></option>
    <option name="CONSOLE_GREEN_OUTPUT"><value><option name="FOREGROUND" value="{{ accent }}"/></value></option>
    <option name="CONSOLE_YELLOW_OUTPUT"><value><option name="FOREGROUND" value="{{ warning }}"/></value></option>
    <option name="CONSOLE_BLUE_OUTPUT"><value><option name="FOREGROUND" value="{{ focus }}"/></value></option>
    <option name="CONSOLE_MAGENTA_OUTPUT"><value><option name="FOREGROUND" value="{{ accentAlt }}"/></value></option>
    <option name="CONSOLE_CYAN_OUTPUT"><value><option name="FOREGROUND" value="{{ ice }}"/></value></option>
    <option name="CONSOLE_GRAY_OUTPUT"><value><option name="FOREGROUND" value="{{ textSecondary }}"/></value></option>
    <option name="CONSOLE_DARKGRAY_OUTPUT"><value><option name="FOREGROUND" value="{{ textMuted }}"/></value></option>
    <option name="CONSOLE_RED_BRIGHT_OUTPUT"><value><option name="FOREGROUND" value="{{ danger }}"/></value></option>
    <option name="CONSOLE_GREEN_BRIGHT_OUTPUT"><value><option name="FOREGROUND" value="{{ accent }}"/></value></option>
    <option name="CONSOLE_YELLOW_BRIGHT_OUTPUT"><value><option name="FOREGROUND" value="{{ warning }}"/></value></option>
    <option name="CONSOLE_BLUE_BRIGHT_OUTPUT"><value><option name="FOREGROUND" value="{{ focus }}"/></value></option>
    <option name="CONSOLE_MAGENTA_BRIGHT_OUTPUT"><value><option name="FOREGROUND" value="{{ accentAlt }}"/></value></option>
    <option name="CONSOLE_CYAN_BRIGHT_OUTPUT"><value><option name="FOREGROUND" value="{{ ice }}"/></value></option>
    <option name="CONSOLE_WHITE_OUTPUT"><value><option name="FOREGROUND" value="{{ textPrimary }}"/></value></option>
  </attributes>
</scheme>
